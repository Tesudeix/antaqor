# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (user-uploaded files)
/public/uploads/*
!/public/uploads/.gitkeep
.next-staging
.next-prev

# 2026-11-05: нууц, гишүүдийн дата, лог, том файл repo-д орохгүй
*.bak
*.bak.*
*.bak[0-9]*
*.bak-*
*.tmp.ts
._*
/.next*/
/data/
/logs/
/_theme_backup/
/.ytfiles/
/.idea/
/.claude/
/assets/
/*.webm
/*.mp4
/*.mp3
